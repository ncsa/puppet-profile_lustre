<%- | $source_path,
| -%>
#!/bin/bash
# This file is managed by Puppet

source /etc/telegraf/lustre/lustre_config

## Tmp File Mgmt
rm -f /tmp/tig_lustre*

tfile1=$(mktemp /tmp/tig_lustre1.XXXXXX)
tfile2=$(mktemp /tmp/tig_lustre2.XXXXXXX)

## Lustre Ping
for m in ${mgs[@]}
do
        lping=$(/usr/sbin/lctl ping ${m} | head -n 1)

        if [ -z $(echo ${lping} | grep -i error) ]; then
                echo "lctl_ping,target=${m} ping_error=0"
        else
                echo "lctl_ping,target=${m} ping_error=1"
        fi
done

## FS Responsive Test ##
for p in ${paths[@]}
do
        { time ls ${p} ; } 2> ${tfile1} 1> /dev/null
        min=$(cat ${tfile1} | grep real | awk '{print $2}' | cut -d'm' -f 1)
        sec=$(cat ${tfile1} | grep real | awk '{print $2}' | cut -d'm' -f 2 | cut -d's' -f 1)
        time=$( bc -l <<<"60*$min + $sec" )
        echo fs_ls_time,path=${p} duration=${time}
done

for f in ${files[@]}
do
        { time stat ${f} ; } 2> ${tfile2} 1> /dev/null
        min=$(cat ${tfile2} | grep real | awk '{print $2}' | cut -d'm' -f 1)
        sec=$(cat ${tfile2} | grep real | awk '{print $2}' | cut -d'm' -f 2 | cut -d's' -f 1)
        time=$( bc -l <<<"60*$min + $sec" )
        echo fs_stat_time,path=${f} duration=${time}
done

## FS Mount Health Check
for f in ${fs[@]}
do
        check=$(grep $f /proc/mounts | grep lustre)
nets=($(sudo /usr/sbin/lnetctl net show | grep "net\ type:" | grep -v ":\ lo" | awk '{print $NF}' | xargs))

for n in ${nets[@]}
do
        sudo /usr/sbin/lnetctl net show --net ${n} -v 3 | sed 's/health\ /health_/' | sed 's/no\ route/no_route/' > "${tfile1}"
        interfaces=($(grep -A1 interfaces "${tfile1}" | grep "0:" | awk '{print $NF}' | xargs))
        for i in ${interfaces[@]}
        do
                status=$(grep -B2 ${i} ${tfile1} | grep status | awk '{print $NF}')
                if [ "${status}" == "up" ]; then
                        echo "lnet_detail_stats,net=${n},interface=${i},counter_type=status state=\"${status}\",is_up=1"
                else
                        echo "lnet_detail_stats,net=${n},interface=${i},counter_type=status state=\"${status}\",is_up=0"
                fi
                for c in ${counter_types[@]}
                do
                        if [ ${c} == "statistics" ]; then
                                stats_line=$(grep -A 31 "0: ${i}" "${tfile1}" | grep -A 3 "statistics" | tail -n +2 | sed 's/:\ /=/' | xargs | sed 's/\ /,/g')
                        elif [ ${c} == "health_stats" ]; then
                                stats_line=$(grep -A 31 "0: ${i}" "${tfile1}" | grep -A 8 "health_stats" | tail -n +2 | sed 's/:\ /=/' | xargs | sed 's/\ /,/g')
                        else
                                stats_line=$(grep -A 31 "0: ${i}" "${tfile1}" | grep -A 5 "${c}" | tail -n +2 | sed 's/:\ /=/' | xargs | sed 's/\ /,/g')
                        fi
                        echo "lustre_client_lnet_stats,net=${n},interface=${i},counter_type=${c} ${stats_line}"
                done
        done
done

for f in ${filesystems[@]}
do
        /usr/sbin/lctl get_param mdc.${f}-*.rpc_stats > ${tfile1}
        /usr/sbin/lctl get_param osc.${f}-*.rpc_stats > ${tfile2}

        mdc_read_rpc_in_flight=$(grep "read RPCs in flight" ${tfile1} | awk '{print $5}' | paste -sd+ | bc)
        mdc_write_rpc_in_flight=$(grep "write RPCs in flight" ${tfile1} | awk '{print $5}' | paste -sd+ | bc)
        mdc_pending_read_pages=$(grep "pending read pages" ${tfile1} | awk '{print $4}' | paste -sd+ | bc)
        mdc_pending_write_pages=$(grep "pending write pages" ${tfile1} | awk '{print $4}' | paste -sd+ | bc)

        osc_read_rpc_in_flight=$(grep "read RPCs in flight" ${tfile2} | awk '{print $5}' | paste -sd+ | bc)
        osc_write_rpc_in_flight=$(grep "write RPCs in flight" ${tfile2} | awk '{print $5}' | paste -sd+ | bc)
        osc_dio_rpcs_in_flight=$(grep "DIO RPCs in flight" ${tfile2} | awk '{print $5}' | paste -sd+ | bc)
        osc_pending_read_pages=$(grep "pending read pages" ${tfile2} | awk '{print $4}' | paste -sd+ | bc)
        osc_pending_write_pages=$(grep "pending write pages" ${tfile2} | awk '{print $4}' | paste -sd+ | bc)

        echo "lustre_client_rpc_stats,fs=${f} mdc_read_rpc_in_flight=${mdc_read_rpc_in_flight},mdc_write_rpc_in_flight=${mdc_write_rpc_in_flight},mdc_pending_read_pages=${mdc_pending_read_pages},mdc_pending_write_pages=${mdc_pending_write_pages},osc_read_rpc_in_flight=${osc_read_rpc_in_flight},osc_write_rpc_in_flight=${osc_write_rpc_in_flight},osc_dio_rpcs_in_flight=${osc_dio_rpcs_in_flight},osc_pending_read_pages=${osc_pending_read_pages},osc_pending_write_page=${osc_pending_write_pages}"

        /usr/sbin/lctl get_param mdc.${f}-*.timeouts > ${tfile1}
        /usr/sbin/lctl get_param osc.${f}-*.timeouts > ${tfile2}

        mdc_avg_reply_time=$(cat ${tfile1} | grep "last reply" | cut -d' ' -f 5 | sed 's/s//g' | awk '{sum+=$1} END {print sum/NR}')
        mdc_max_reply_time=$(cat ${tfile1} | grep "last reply" | cut -d' ' -f 5 | sed 's/s//g' | sort -un | tail -n 1)
        mdc_median_reply_time=$(cat ${tfile1} | grep "last reply" | cut -d' ' -f 5 | sed 's/s//g' | awk '{a[NR]=$1} END {asort(a); if (NR%2==1) print a[(NR+1)/2]; else print (a[NR/2]+a[NR/2+1])/2}')
        osc_avg_reply_time=$(cat ${tfile2} | grep "last reply" | cut -d' ' -f 5 | sed 's/s//g' | awk '{sum+=$1} END {print sum/NR}')
        osc_max_reply_time=$(cat ${tfile2} | grep "last reply" | cut -d' ' -f 5 | sed 's/s//g' | sort -un | tail -n 1)
        osc_median_reply_time=$(cat ${tfile2} | grep "last reply" | cut -d' ' -f 5 | sed 's/s//g' | awk '{a[NR]=$1} END {asort(a); if (NR%2==1) print a[(NR+1)/2]; else print (a[NR/2]+a[NR/2+1])/2}')

        echo "lustre_client_target_timeout,fs=${f} mdc_avg_reply_time=${mdc_avg_reply_time},mdc_max_reply_time=${mdc_max_reply_time},mdc_median_reply_time=${mdc_median_reply_time},osc_avg_reply_time=${osc_avg_reply_time},osc_max_reply_time=${osc_max_reply_time},osc_median_reply_time=${osc_median_reply_time}"
done

        /usr/sbin/lctl get_param llite.${f}-*.stats > ${tfile1}
        stats=$(cat ${tfile1} | grep -v time | awk '$7 != "" {print $1" "$7}' | awk '{sums[$1]+=$2} END{for (i in sums) print i, sums[i]}' | sort | sed 's/\ /=/' | tr '\n' ',' | sed 's/,$//')
        echo "lustre_client_clientside_perf_stats,fs=${f} ${stats}"

        /usr/sbin/lctl get_param ldlm.namespaces.${f}-*.pool.stats > ${tfile1}
        stats=$(cat ${tfile1} | grep -v time | grep -v namespaces | sort -k1 | awk '$7 != "" {print $1" "$7}' | awk '{sums[$1]+=$2} END{for (i in sums) print i, sums[i]}' | sort | sed 's/\ /=/' | tr '\n' ',' | sed 's/,$//')
        echo "lustre_client_ldlm_pool_stats,fs=${f} ${stats}"

        /usr/sbin/lctl get_param ldlm.namespaces.${f}-*.resource_count > ${tfile1}
        locks=$(cat ${tfile1} | cut -d'=' -f 2 | paste -sd+ | bc)
        echo "lustre_client_ldlm_resource_stats,fs=${f} locks=${locks}"

## Cleanup
rm -f ${tfile1} ${tfile2}
